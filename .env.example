# Copy this file to ".env" and fill in your key. Never commit the real ".env" file.

# Which LLM provider LangChain should use: "groq" (free & fast, default) or "openai"
LLM_PROVIDER=groq

# --- Groq (recommended - has a free tier) ---
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenAI (optional alternative provider) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
